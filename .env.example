# Copy this file to .env and fill in real values. Never commit .env.
# Local development: DJANGO_DEBUG=True. Production: DJANGO_DEBUG=False.

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace_me_with_a_local_secret_key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Database. Leave empty for SQLite (db.sqlite3). For PostgreSQL use:
# postgres://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME
DATABASE_URL=

# Production security (used only while DJANGO_DEBUG=False).
# DJANGO_SECRET_KEY is required in all environments; set a private random value above.
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Security headers (set only when served over HTTPS in production)
DJANGO_SECURE_COOKIES=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False
DJANGO_BEHIND_PROXY=False

# Content-Security-Policy is enforced by config.security_middleware.SecurityHeadersMiddleware.
# Adjust CSP directives there if you add third-party scripts, fonts, or images.

# Local rate-limit cache. Production multi-worker deployments should use Django's shared database cache.
DJANGO_CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
DJANGO_CACHE_LOCATION=gachghar-local

# Email (password reset and welcome emails). Leave the backend as console for local testing.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# Media storage - local filesystem by default. For production with object storage
# (S3, GCS, Azure Blob, etc.), set MEDIA_STORAGE_BACKEND and the provider's
# credentials. See config/settings.py for the S3 example.
MEDIA_STORAGE_BACKEND=

# AWS S3 example (requires django-storages and boto3, not in requirements.txt):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# AWS_DEFAULT_ACL=private
# AWS_S3_FILE_OVERWRITE=False

# GachGhar AI Gardener. Leave AI_PROVIDER empty to run in basic mode (no AI model, store works normally).
# AI_PROVIDER: openai  (or any OpenAI-compatible API, with AI_BASE_URL)  |  anthropic
# This needs an API key from the provider's developer platform. A ChatGPT or Claude chat subscription does NOT include API access.
AI_PROVIDER=
AI_PROVIDER_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_RATE_LIMIT_PER_10_MIN=20
AI_DAILY_MESSAGE_LIMIT=100
AI_MAX_OUTPUT_TOKENS=600
AI_TIMEOUT_SECONDS=25

# Local Razorpay checkout must use Test Mode credentials. Never use live keys locally.
# Shipping carrier integration is manual; see docs/OPERATIONS.md.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
